# 环境变量模板：复制为项目根目录的 .env（cp .env.example .env）。
# 本地开发（backend/app/config.py 直接读取）与 docker compose（从同一文件插值）共用这一份。
# ===== DeepSeek 大模型配置 =====

# DeepSeek API Key
# 未配置时，查询接口将返回一条用户友好的系统错误提示（不会伪造查询结果）。
DEEPSEEK_API_KEY=

# 模型 ID：deepseek-v4-pro或 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash

# OpenAI 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== MongoDB 会话记忆配置 =====
# 连接串格式：mongodb://<用户名>:<密码>@<host>:<port>/?authSource=<认证库>
# 本机 MongoDB 已开启认证（用户名/密码均为 root，认证库 admin）
MONGO_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGO_DB=chongqing_ai

# ===== 长对话记忆治理（可选，注释掉即用默认值）=====
# 近期窗口保留的历史条数（同时是滚动摘要的边界）
# CHAT_HISTORY_MAX_MESSAGES=20
# 近期窗口的 token 预算
# CHAT_HISTORY_MAX_TOKENS=2400
# 滚动摘要长度上限（字数）
# CHAT_SUMMARY_MAX_CHARS=300

# ===== 外部 embedding + Milvus 向量检索=====
# 阿里云 DashScope 兼容端点，模型 text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# 本地 Milvus 地址
MILVUS_URI=http://localhost:19530
